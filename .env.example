# Pharmacy POS — Development Configuration
# Copy this file to .env and fill in values
# DO NOT commit .env to version control

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos
DB_USER=pos
DB_PASSWORD=pos

# JWT / Session
JWT_SECRET=replace-with-256-bit-secret
JWT_EXPIRATION=86400000

# Server
SERVER_PORT=9090

# SMTP Email (Gmail app password)
MAIL_USERNAME=
MAIL_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# M-Pesa (Safaricom Daraja) — Sandbox keys
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://localhost:9090/api/v1/payments/mpesa/callback

# Stripe — Test keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack — Test keys (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:9090/api/v1/payments/paystack/callback

# Feature Flags
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_AUTH_RPS=5

# eTIMS Compliance
COMPLIANCE_MODE=MOCK
FISCAL_MODE=LOCAL
FISCAL_API_KEY=change-me

# Backup
BACKUP_KEY=pharmacy-pos-backup-key
