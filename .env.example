# Pharmacy POS local development configuration
# Copy to .env. Never commit the resulting .env file.

# PostgreSQL used by Docker Compose
POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_only
POSTGRES_PORT=5432

# API
SERVER_PORT=9090
SPRING_PROFILES_ACTIVE=offline
POS_TIMEZONE=Africa/Nairobi
POS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser authentication uses a server-side session cookie, not JWT.
# Keep secure=false only for local HTTP. Production sets it to true.
POS_SESSION_COOKIE_SECURE=false
POS_SESSION_COOKIE_SAME_SITE=strict
POS_SESSION_IDLE_TIMEOUT=30m
POS_SESSION_ABSOLUTE_TIMEOUT=12h

# Development convenience only. Set false for every real pharmacy.
POS_SEED_DEMO_ENABLED=true

# A local node never needs internet to complete checkout.
# Do not select hybrid until a compatible central API has been deployed.
POS_SYNC_MODE=local
POS_SYNC_CENTRAL_URL=http://host.docker.internal:9090
POS_SYNC_POLL_INTERVAL_SECONDS=30

# Current MVP boundaries
POS_FEATURES_FISCAL=false
POS_FISCAL_ENABLED=false
POS_FEATURES_DEVICES=false
POS_FEATURES_EMAIL=false
POS_FEATURES_SMS=false
POS_SALES_RETURN_WINDOW_DAYS=7

# Local profile defaults to no rate limit for easier development.
POS_RATE_LIMIT_ENABLED=false
POS_RATE_LIMIT_RPS=20
POS_RATE_LIMIT_AUTH_RPS=5
